# Optional for local development. GitHub Actions derives these from the repository.
# Set the origin only, without a repository path or trailing page name.
# PUBLIC_SITE_URL=https://yourname.github.io
# PUBLIC_BASE_PATH=/portfolio/

# For a custom domain, set the same repository variables on GitHub:
# PUBLIC_SITE_URL=https://www.yourdomain.com
# PUBLIC_BASE_PATH=/
