---
import { site } from '../config/site';
import { withBase } from '../lib/paths';
import Icon from './Icon.astro';
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-main">
      <div class="footer-identity"><a href={withBase('/')} class="brand"><span class="monogram" aria-hidden="true">{site.initials.toLowerCase()}<span>.</span></span><span>{site.name}</span></a><p>{site.footerDescription}</p></div>
      <div class="footer-links"><span class="eyebrow">EXPLORE</span><div>{site.navigation.map(({label,href}) => <a href={withBase(href)}>{label}</a>)}</div></div>
      <div class="footer-links"><span class="eyebrow">ELSEWHERE</span><div>{site.socials.map(({label,href}) => <a href={href} target="_blank" rel="noopener noreferrer">{label} <Icon name="diagonal" size={13}/></a>)}<a href={`mailto:${site.email}`}>Email <Icon name="diagonal" size={13}/></a></div></div>
    </div>
    <div class="footer-bottom"><span>© {new Date().getUTCFullYear()} {site.name}</span><span>Made with curiosity.<span class="footer-spark" aria-hidden="true"> ✧</span></span><a href="#top">Back to top ↑</a></div>
  </div>
</footer>
