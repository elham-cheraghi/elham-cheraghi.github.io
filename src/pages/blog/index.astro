---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PageHeading from '../../components/PageHeading.astro';
import Icon from '../../components/Icon.astro';
import { site } from '../../config/site';
import { withBase, formatDate } from '../../lib/paths';
const posts=(await getCollection('blog',({data})=>import.meta.env.DEV||!data.draft)).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
---
<Layout title="Blog" description={`Notes on algorithms, machine learning, and the things learned along the way. Writing by ${site.name}.`}>
  <div class="container blog-page"><PageHeading eyebrow="THINKING OUT LOUD" title="Notes & observations" description="A space for ideas, experiments, and things I learn along the way."/>
    {posts.length>0 ? <div class="post-list">{posts.map(post=><article class="post-preview"><div class="post-date"><time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>{post.data.draft&&<span class="draft-label">EXAMPLE DRAFT · LOCAL PREVIEW ONLY</span>}</div><div><h2><a href={withBase(`/blog/${post.id}/`)}>{post.data.title}<Icon name="diagonal"/></a></h2><p>{post.data.description}</p><ul class="tags">{post.data.tags.map(tag=><li>{tag}</li>)}</ul></div></article>)}</div>:<div class="empty-state"><div class="empty-icon"><Icon name="book" size={30}/></div><span class="eyebrow">A BLANK PAGE, FOR NOW</span><h2>Good ideas need a little time<span class="accent">.</span></h2><p>No published posts yet. In the meantime, take a look at the projects behind the questions.</p><a class="text-link" href={withBase('/projects/')}>Explore my projects <Icon name="arrow" size={17}/></a></div>}
  </div>
</Layout>
