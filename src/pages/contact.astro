---
import Layout from '../layouts/Layout.astro';
import PageHeading from '../components/PageHeading.astro';
import Icon from '../components/Icon.astro';
import { site } from '../config/site';
---
<Layout title="Contact" description={`Get in touch with ${site.name} by email, or connect on GitHub and LinkedIn to discuss research, projects, and shared interests.`}><div class="container contact-page"><PageHeading eyebrow="EVERY CONNECTION STARTS SOMEWHERE" title="Let’s talk" description="A research question, a project idea, or simply a hello. I’d be happy to hear from you."/><div class="contact-grid"><section class="email-card" aria-labelledby="email-heading"><div class="contact-icon"><Icon name="mail" size={25}/></div><span class="eyebrow">THE BEST WAY TO REACH ME</span><h2 id="email-heading">Start a conversation<span class="accent">.</span></h2><p>Drop me a line about what you’re working on or what’s on your mind.</p><a class="email-address" href={`mailto:${site.email}`}>{site.email}<Icon name="diagonal" size={26}/></a><span class="email-note">Opens your email app.</span></section><div class="contact-elsewhere"><span class="eyebrow">FIND ME ELSEWHERE</span>{site.socials.map(({label,href})=><a href={href} target="_blank" rel="noopener noreferrer" class="social-card"><Icon name={label.toLowerCase()} size={23}/><div><h2>{label}</h2><p>{label==='GitHub'?'Code, projects, and experiments.':'Experience and professional connections.'}</p></div><Icon name="diagonal" size={19}/></a>)}<div class="contact-location"><Icon name="location" size={17}/><span>Based in {site.location}</span></div></div></div><div class="contact-signoff"><span aria-hidden="true">✧</span><p>Different perspectives. Shared curiosity.<br/>Let’s see where a conversation takes us.</p></div></div></Layout>
