---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Particles from '../components/Particles.astro';
import Icon from '../components/Icon.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ContactBanner from '../components/ContactBanner.astro';
import { site } from '../config/site';
import { withBase } from '../lib/paths';
const projects = (await getCollection('projects',({data})=>data.featured)).sort((a,b)=>a.data.order-b.data.order);
---
<Layout title="Home" description={site.description}>
  <section class="hero" aria-labelledby="hero-heading">
    <Particles/>
    <div class="hero-content container">
      <div class="hero-kicker"><span class="status-dot" aria-hidden="true"></span>{site.role}</div>
      <h1 id="hero-heading">{site.name}<span class="accent">.</span></h1>
      <p class="hero-tagline">{site.tagline}</p>
      <div class="hero-actions"><a class="button button-primary" href={withBase('/projects/')}>Explore my work <Icon name="arrow" size={18}/></a><a class="button button-secondary" href={withBase('/contact/')}>Get in touch <Icon name="diagonal" size={17}/></a></div>
      <div class="hero-socials">{site.socials.map(({label,href})=><a href={href} target="_blank" rel="noopener noreferrer"><Icon name={label.toLowerCase()} size={17}/>{label}<Icon name="diagonal" size={12}/></a>)}<span class="social-divider" aria-hidden="true"></span><a href={withBase('/cv/')}><Icon name="file" size={17}/>Curriculum vitae<Icon name="diagonal" size={12}/></a></div>
    </div>
    <div class="hero-bottom container"><span><Icon name="location" size={13}/> {site.location}</span><a href="#intro">A little further down <Icon name="down" size={13}/></a><span class="hero-note">Always curious<span class="accent"> ✧</span></span></div>
  </section>
  <section id="intro" class="intro-section container" aria-labelledby="intro-heading">
    <div class="intro-heading"><span class="eyebrow"><span class="tiny-star" aria-hidden="true">✧</span> A LITTLE ABOUT ME</span><h2 id="intro-heading">Curiosity,<br/>turned into <span class="serif-accent">code.</span></h2></div>
    <div class="intro-copy">{site.intro.map((paragraph,i)=><p>{i===0&&`Hi, I’m ${site.firstName}. `}{paragraph}</p>)}<a class="text-link" href={withBase('/about/')}>More about me <Icon name="arrow" size={17}/></a></div>
  </section>
  <section class="work-section container" aria-labelledby="work-heading">
    <div class="section-header"><div><span class="eyebrow">RESEARCH & EXPERIMENTS</span><h2 id="work-heading">Selected work<span class="accent">.</span></h2></div><a class="text-link" href={withBase('/projects/')}>All projects <Icon name="diagonal" size={16}/></a></div>
    <div class="projects-grid">{projects.map(project=><ProjectCard project={project}/>)}</div>
    <p class="section-footnote"><span class="status-dot" aria-hidden="true"></span> A few things I’ve researched, built, and learned along the way.</p>
  </section>
  <section class="skills-section" aria-labelledby="skills-heading"><div class="container"><div class="section-header"><div><span class="eyebrow">MY TOOLBOX</span><h2 id="skills-heading">Ideas meet implementation<span class="accent">.</span></h2></div><span class="section-aside">The tools behind the work.</span></div><div class="skills-grid">{site.skills.map((group,i)=><div class="skill-group"><span class="skill-number">0{i+1}</span><h3>{group.label}</h3><ul>{group.items.map(skill=><li>{skill}</li>)}</ul></div>)}</div></div></section>
  <ContactBanner/>
</Layout>
