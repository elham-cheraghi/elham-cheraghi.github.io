---
import Layout from '../layouts/Layout.astro';
import PageHeading from '../components/PageHeading.astro';
import ContactBanner from '../components/ContactBanner.astro';
import Icon from '../components/Icon.astro';
import { site } from '../config/site';
import { experience } from '../data/experience';
import { withBase } from '../lib/paths';
---
<Layout title="About" description={`Meet ${site.name}: computer science education, interests in machine learning and bioinformatics, frontend development, and teaching experience.`}>
  <div class="container"><PageHeading eyebrow="THE PERSON BEHIND THE PROJECTS" title="A little about me" description="A background in computer science. A curiosity for complex systems. A habit of learning by building."/>
    <section class="about-intro" aria-labelledby="bio-heading"><div class="about-copy"><h2 id="bio-heading">Hi, I’m {site.firstName}<span class="accent">.</span></h2>{site.bio.map(p=><p>{p}</p>)}<a href={withBase('/cv/')} class="text-link">View my curriculum vitae <Icon name="arrow" size={17}/></a></div><div class="profile-card">{site.photo?<img src={withBase(site.photo)} alt={site.name} width="480" height="480" class="profile-photo"/>:<div class="profile-art" aria-hidden="true"><span class="profile-orbit orbit-one"></span><span class="profile-orbit orbit-two"></span><span class="profile-orbit orbit-three"></span><span class="profile-initials">{site.initials.toLowerCase()}<span class="accent">.</span></span><span class="orbit-star">✧</span></div>}<div class="profile-caption"><span>{site.name}</span><span><Icon name="location" size={13}/>{site.location}</span></div></div></section>
    <section class="about-section" aria-labelledby="interests-heading"><div><span class="eyebrow">QUESTIONS THAT KEEP ME CURIOUS</span><h2 id="interests-heading">Research interests<span class="accent">.</span></h2></div><ul class="interest-list">{site.interests.map((item,i)=><li><span class="interest-number">0{i+1}</span>{item}</li>)}</ul></section>
    <section class="about-section" aria-labelledby="education-heading"><div><span class="eyebrow">FOUNDATIONS</span><h2 id="education-heading">Education<span class="accent">.</span></h2></div><div class="timeline">{site.education.map(item=><article class="timeline-entry"><span class="eyebrow">{item.period}</span><h3>{item.degree}</h3><p class="timeline-org">{item.institution}</p><ul>{item.details.map(detail=><li>{detail}</li>)}</ul></article>)}</div></section>
    <section class="about-section" aria-labelledby="experience-heading"><div><span class="eyebrow">BUILDING & SHARING</span><h2 id="experience-heading">Experience<span class="accent">.</span></h2></div><div class="timeline">{experience.map(item=><article class="timeline-entry"><span class="eyebrow">{item.period}</span><h3>{item.title}</h3><p class="timeline-org">{item.organization}</p><p>{item.description}</p><ul>{item.highlights.map(detail=><li>{detail}</li>)}</ul>{item.href&&<a href={item.href} class="text-link" target="_blank" rel="noopener noreferrer">Course repository <Icon name="diagonal" size={14}/></a>}</article>)}</div></section>
  </div><ContactBanner/>
</Layout>
