---
import { existsSync } from 'node:fs';
import { resolve } from 'node:path';
import Layout from '../layouts/Layout.astro';
import PageHeading from '../components/PageHeading.astro';
import Icon from '../components/Icon.astro';
import { site } from '../config/site';
import { withBase } from '../lib/paths';
const hasCV=site.cv.available&&existsSync(resolve('public',site.cv.path.replace(/^\//,'')));
---
<Layout title="Curriculum vitae" description={`View or download ${site.name}’s curriculum vitae, covering computer science education, research, technical projects, and experience.`}><div class="container cv-page"><PageHeading eyebrow="THE DETAILS, IN ONE PLACE" title="Curriculum vitae" description="My education, research, experience, and technical skills — collected in one document."/>
  <section class="cv-card" aria-labelledby="cv-document-heading"><div class="cv-document" aria-hidden="true"><div class="cv-paper"><span class="paper-name">{site.name}</span><span class="paper-role">COMPUTER SCIENCE</span><span class="paper-line accent-line"></span><span class="paper-line"></span><span class="paper-line short"></span><span class="paper-section">EDUCATION</span><span class="paper-line"></span><span class="paper-line short"></span><span class="paper-section">RESEARCH & EXPERIENCE</span><span class="paper-line"></span><span class="paper-line"></span><span class="paper-line short"></span><span class="paper-section">SELECTED PROJECTS</span><span class="paper-line"></span><span class="paper-line short"></span></div></div><div class="cv-card-copy"><span class="eyebrow">CURRICULUM VITAE / PDF</span><h2 id="cv-document-heading">The longer version<span class="accent">.</span></h2><p>A closer look at the work behind this website, from academic foundations to hands-on projects.</p>{hasCV?<><div class="cv-actions"><a class="button button-primary" href={withBase(site.cv.path)} target="_blank" rel="noopener noreferrer">View CV <Icon name="diagonal" size={17}/></a><a class="button button-secondary" href={withBase(site.cv.path)} download={`${site.name.replaceAll(' ','-')}-CV.pdf`}>Download PDF <Icon name="download" size={17}/></a></div><span class="cv-availability"><span class="status-dot"></span> PDF document · opens in a new tab</span></>:<p class="cv-unavailable">My PDF CV will be available here soon. For now, you can explore my <a href={withBase('/about/')}>background and experience</a>.</p>}</div></section><p class="cv-question">Looking for something specific? <a class="text-link" href={`mailto:${site.email}`}>Get in touch <Icon name="arrow" size={15}/></a></p></div></Layout>
